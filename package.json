{
  "name": "payload-nextjs-starter",
  "version": "1.0.0",
  "private": true,
  "description": "A production-ready Next.js + Payload CMS starter template with dynamic pages, blocks-based layout, and Docker dev infrastructure.",
  "engines": {
    "node": ">=20",
    "pnpm": "9.x"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed": "NODE_OPTIONS=--no-deprecation tsx seed/index.ts",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "payload": "npx payload",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.85.0",
    "@payloadcms/live-preview-react": "3.85.0",
    "@payloadcms/next": "3.85.0",
    "@payloadcms/richtext-lexical": "3.85.0",
    "@payloadcms/storage-s3": "3.85.0",
    "@payloadcms/ui": "3.85.0",
    "argon2": "^0.44.0",
    "class-variance-authority": "^0.7.1",
    "cli-color": "^2.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "payload": "3.85.0",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@next/env": "16.2.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^4",
    "tsx": "4.22.4",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "@next/env": "16.2.6",
      "tsx": "4.22.4"
    },
    "patchedDependencies": {
      "@next/env@16.2.6": "patches/@next__env@16.2.6.patch"
    }
  }
}
