# Database
DATABASE_URI=postgresql://app:appdev@localhost:5434/app_web

# Payload secret (used to encrypt JWT tokens, etc.)
PAYLOAD_SECRET=change-me-to-a-random-string

# Media base URL (default: localhost, the nginx proxy)
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost

# S3 / MinIO storage (for media uploads)
S3_BUCKET=app-public-dev
S3_ENDPOINT=http://localhost:9010
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123

# Optional: bypass maintenance mode with ?bypass=<secret>
# MAINTENANCE_BYPASS_SECRET=your-secret-here
